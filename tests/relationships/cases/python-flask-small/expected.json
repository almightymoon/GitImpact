{
  "description": "Python Flask decorator routes + service CALLS",
  "mustImport": [
    { "from": "FILE:app.py", "to": "FILE:services/auth.py" }
  ],
  "mustCall": [
    {
      "from": "FUNCTION:app.py:login",
      "to": "FUNCTION:services/auth.py:issue_token"
    },
    {
      "from": "FUNCTION:app.py:me",
      "to": "FUNCTION:services/auth.py:verify_token"
    },
    {
      "from": "FUNCTION:services/auth.py:require_auth",
      "to": "FUNCTION:services/auth.py:verify_token"
    }
  ],
  "mustEdge": [
    {
      "from": "FILE:app.py",
      "to": "FUNCTION:services/auth.py:issue_token",
      "type": "USES"
    },
    {
      "from": "API_ROUTE:flask:POST:/login:app.py",
      "to": "FUNCTION:app.py:login",
      "type": "HANDLED_BY"
    },
    {
      "from": "API_ROUTE:flask:GET:/me:app.py",
      "to": "FUNCTION:app.py:me",
      "type": "HANDLED_BY"
    }
  ]
}

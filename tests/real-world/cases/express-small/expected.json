{
  "description": "Express middleware composition + service calls",
  "unsupportedPatterns": [
    "middleware-compose-hof",
    "framework-app-post-binding"
  ],
  "mustDetectRoutes": [
    { "method": "POST", "path": "/login" }
  ],
  "mustImport": [
    { "from": "FILE:src/middleware/auth.ts", "to": "FILE:src/services/auth.ts" },
    { "from": "FILE:src/routes/auth.ts", "to": "FILE:src/middleware/auth.ts" },
    { "from": "FILE:src/routes/auth.ts", "to": "FILE:src/services/auth.ts" }
  ],
  "mustCall": [
    {
      "from": "FUNCTION:src/middleware/auth.ts:requireAuth",
      "to": "FUNCTION:src/services/auth.ts:verifyToken"
    }
  ],
  "softMustCall": [
    {
      "from": "FUNCTION:src/routes/auth.ts:loginHandler",
      "to": "FUNCTION:src/services/auth.ts:issueToken",
      "note": "Call inside compose() HOF callback may not attach to loginHandler symbol"
    },
    {
      "fromContains": "src/routes/auth.ts",
      "to": "FUNCTION:src/middleware/compose.ts:compose",
      "note": "compose() used as initializer may not emit a CALLS edge from a named function"
    }
  ],
  "knownUnresolved": [
    {
      "pattern": "middleware-compose-hof",
      "note": "compose(...handlers) higher-order wiring"
    }
  ]
}

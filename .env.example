# Copy to apps/web/.env.local or export in your shell

# Postgres persistence (optional — falls back to in-memory if unset)
DATABASE_URL=postgresql://gitimpact:gitimpact@localhost:5432/gitimpact

# GitHub API — required to post PR comments (v0.6)
# GITHUB_TOKEN=

# Webhook HMAC secret for POST /api/webhooks/github
# GITHUB_WEBHOOK_SECRET=

# Public workbench URL embedded in PR comments
# GITIMPACT_PUBLIC_URL=https://gitimpact.example.com

# Analysis tuning
GITIMPACT_MAX_FILES=800
# GITIMPACT_DEPTH=3
# GITIMPACT_CACHE_DIR=./.repos

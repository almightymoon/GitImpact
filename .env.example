# Copy to apps/web/.env.local or export in your shell

# Postgres persistence (optional — falls back to in-memory if unset)
DATABASE_URL=postgresql://gitimpact:gitimpact@localhost:5432/gitimpact

# GitHub API (optional — higher rate limits for PR analysis)
# GITHUB_TOKEN=

# Analysis tuning
GITIMPACT_MAX_FILES=800
# GITIMPACT_CACHE_DIR=./.repos

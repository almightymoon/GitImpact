# Copy to apps/web/.env.local or export in your shell

# Runtime
# NODE_ENV=development

# Postgres persistence (required in production)
DATABASE_URL=postgresql://gitimpact:gitimpact@localhost:5432/gitimpact

# Redis / BullMQ durable queue (required in production)
# REDIS_URL=redis://localhost:6379

# --- GitHub App (required in production) ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_SLUG=gitimpact
# GITHUB_APP_INSTALL_URL=https://github.com/apps/gitimpact/installations/new
# GITHUB_WEBHOOK_SECRET=

# Dev-only fallback PAT (avoid in production)
# GITHUB_TOKEN=

# Protects POST /api/pr/comment when postComment=true
# GITIMPACT_API_KEY=

# Public workbench URL embedded in PR comments / check runs
# GITIMPACT_PUBLIC_URL=https://gitimpact.example.com

# Host port mapping for docker-compose.prod.yml (default 3000)
# GITIMPACT_WEB_PORT=3001

# Analysis quotas (public beta defaults)
GITIMPACT_MAX_FILES=800
GITIMPACT_MAX_REPOSITORY_FILES=20000
# GITIMPACT_MAX_REPOSITORY_BYTES=524288000
# GITIMPACT_MAX_FILE_BYTES=2097152
# GITIMPACT_MAX_ANALYSIS_DURATION_MS=300000
# GITIMPACT_MAX_GRAPH_NODES=100000
# GITIMPACT_MAX_GRAPH_EDGES=250000
# GITIMPACT_MAX_PR_CHANGED_FILES=500

# Rate limiting
GITIMPACT_ANALYZE_RATE_LIMIT=10
GITIMPACT_ANALYZE_RATE_WINDOW_SECONDS=60

# Cache TTLs
# GITIMPACT_REPO_CACHE_TTL_HOURS=24
# GITIMPACT_PR_CACHE_TTL_HOURS=6

# Jobs
# GITIMPACT_JOB_MAX_ATTEMPTS=3
# GITIMPACT_WORKER_CONCURRENCY=2
# GITIMPACT_FORCE_INLINE_QUEUE=1
# GITIMPACT_RETENTION_INTERVAL_HOURS=6

# Analysis tuning
# GITIMPACT_DEPTH=3
# GITIMPACT_CACHE_DIR=./.repos
